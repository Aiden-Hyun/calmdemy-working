# Calmdemy environment configuration template.
# Copy this file to `.env` and fill in real values for local development.
# Expo bundles EXPO_PUBLIC_* vars into the client at build time. These are
# public client identifiers (RevenueCat SDK keys, Firebase client config,
# OAuth client IDs) — not cryptographic secrets. Security is enforced via
# Firestore rules, Firebase Auth, and RevenueCat dashboard configuration.

# RevenueCat SDK keys (get from RevenueCat dashboard → Project Settings → API keys)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Google Sign-In OAuth client IDs (Google Cloud Console → APIs & Services → Credentials)
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=

# Firebase project configuration (Firebase Console → Project Settings → General → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Admin user allowlist (comma-separated Firebase UIDs; these users bypass the subscription paywall)
EXPO_PUBLIC_ADMIN_UIDS=
