rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents + per-user subcollections ──────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Phase 9 per-user subcollections (journal, mood, CBT)
      match /journalEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /moodEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /cbtEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Routines feature suite (see docs/routines/BUILD_PLAN.md §5.8)
      match /routineProfiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineHabits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineCompletions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineTodos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineGoalTags/{tagId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineTrackers/{trackerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /entries/{dateKey} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      match /routineDayNotes/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routineReminders/{reminderKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Per-user data (top-level collections keyed by a user_id field) ─────
    // All read via user-constrained queries (where user_id == uid), so the read
    // rule must be the plain `resource.data.user_id == uid` form: do NOT add a
    // `resource == null` branch here — it makes Firestore's query analyzer
    // reject the whole list query (a get on a not-yet-created doc will log a
    // caught permission-denied, which the data layer already swallows).
    function ownsExisting() {
      return request.auth != null && resource.data.user_id == request.auth.uid;
    }
    function ownsNew() {
      return request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /meditation_sessions/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
    match /user_favorites/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
    match /listening_history/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
    match /playback_progress/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
    match /completed_content/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
    match /content_ratings/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }

    // Reports are create-only from the client; not read back.
    match /content_reports/{id} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // ── Public read-only content catalogs (no client writes) ──────────────
    // Catalog data served to every signed-in user; writes happen server-side.
    match /guided_meditations/{id}    { allow read: if true; allow write: if false; }
    match /breathing_exercises/{id}   { allow read: if true; allow write: if false; }
    match /bedtime_stories/{id}       { allow read: if true; allow write: if false; }
    match /sleep_meditations/{id}     { allow read: if true; allow write: if false; }
    match /emergency_meditations/{id} { allow read: if true; allow write: if false; }
    match /meditation_programs/{id}   { allow read: if true; allow write: if false; }
    match /courses/{id}               { allow read: if true; allow write: if false; }
    match /course_sessions/{id}       { allow read: if true; allow write: if false; }
    match /series/{id}                { allow read: if true; allow write: if false; }
    match /albums/{id}                { allow read: if true; allow write: if false; }
    match /sleep_sounds/{id}          { allow read: if true; allow write: if false; }
    match /background_sounds/{id}     { allow read: if true; allow write: if false; }
    match /white_noise/{id}           { allow read: if true; allow write: if false; }
    match /music/{id}                 { allow read: if true; allow write: if false; }
    match /asmr/{id}                  { allow read: if true; allow write: if false; }
    match /narrators/{id}             { allow read: if true; allow write: if false; }
    match /daily_quotes/{id}          { allow read: if true; allow write: if false; }
    match /content_index/{id}         { allow read: if true; allow write: if false; }
  }
}
